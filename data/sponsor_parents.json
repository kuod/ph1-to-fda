{
 "as_of": "2026-10-27",
 "what": "Maps the sponsor of record on an FDA application (openFDA sponsor_name, upper-cased) to its parent company AS OF the as_of date, not as of the approval date. tools/taxonomy.py reads this file; rules are tried in order and the first parent whose patterns match wins; a sponsor that matches nothing keeps its own cleaned name.",
 "review": "Change a pattern here, then run `python3 tools/test_taxonomy.py` and `python3 tools/sponsor_report.py`, and commit the regenerated data/sponsor_review.json. Patterns are Python regexes searched in the upper-cased sponsor string: anchor or word-bound anything short. Acquisition dates are not recorded (only the as_of state).",
 "removed_wrong_mappings": [
  {
   "pattern": "XENCOR",
   "was_mapped_to": "Johnson & Johnson",
   "why_wrong": "Xencor is independent; the match credited its approvals to J&J.",
   "fixed": "2026-10-20"
  },
  {
   "pattern": "MARATHON",
   "was_mapped_to": "Takeda",
   "why_wrong": "Marathon Pharmaceuticals is not part of Takeda.",
   "fixed": "2026-10-20"
  },
  {
   "pattern": "ARDELYX",
   "was_mapped_to": "Kyowa Kirin",
   "why_wrong": "Ardelyx is independent.",
   "fixed": "2026-10-20"
  },
  {
   "pattern": "RA PHARM (unanchored)",
   "was_mapped_to": "UCB",
   "why_wrong": "Substring of 'DECIPHERA PHARMS'; Deciphera's approvals were credited to UCB.",
   "fixed": "2026-10-20"
  }
 ],
